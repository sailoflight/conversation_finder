{
  "name": "conversation-finder",
  "version": "0.1.0",
  "description": "The grep of agent session history — compaction-proof search over DSH / Claude Code / Codex / OpenCode logs. Zero dependencies, CLI + MCP.",
  "type": "module",
  "bin": {
    "cfind": "./bin/cfind.mjs",
    "cfind-mcp": "./bin/cfind-mcp.mjs"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "fixture": "node tests/fixtures/make-fixture.mjs",
    "index": "node bin/cfind.mjs index",
    "mcp": "node bin/cfind-mcp.mjs"
  },
  "keywords": [
    "grep",
    "session-history",
    "agent",
    "search",
    "sqlite",
    "fts5",
    "compaction",
    "mcp",
    "claude-code",
    "codex",
    "opencode",
    "dsh"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sailoflight/conversation-finder.git"
  }
}
